# Local FalkorDB connection. Copy to .env to override.
# Set credentials if the FalkorDB instance requires Redis authentication.

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=enterprise_kpi

# The physical table is agentic_kg_usecase. project stays blank until known.
# The loader reads customer-ontology/enterprise_kpi_ontology.csv.
SOURCE_TABLE=agentic_kg_usecase
PROVENANCE_PLATFORM=BIGQUERY
DATA_VERSION=2.0.0
SOURCE_FIELD_MAPPING=MAP:agentic_kg_usecase:2.0.0
BIGQUERY_BATCH_SIZE=100
INPUT_DATA_FILE=data/sample_data.json
ONTOLOGY_FILE=ontology/enterprise_kpi_ontology.csv
BIGQUERY_PROJECT=
BIGQUERY_TABLE_NAME=agentic_kg_usecase
