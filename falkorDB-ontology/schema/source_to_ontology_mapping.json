{
  "mapping_id": "MAP:agentic_kg_usecase:2.0.0",
  "version": "2.0.0",
  "physical_table": "agentic_kg_usecase",
  "platform": "BIGQUERY",
  "project": "",
  "use_case": "agentic_kg",
  "source": "customer-ontology/enterprise_kpi_ontology.csv",
  "fact_storage": "Cell values and monthly facts stay in BigQuery. The graph stores schema and measure definitions only.",
  "retired_labels": [
    "ReportingPeriod",
    "KPIObservation",
    "RiskProfile",
    "KPIMeasure"
  ],
  "nodes": [
    {
      "label": "BQ_Table",
      "identity": "table_id",
      "role": "Physical table. Parent of every column through HAS_COLUMN."
    },
    {
      "label": "BQ_column",
      "identity": "column_id",
      "role": "One node per physical column. YEAR and REPORTING_MONTH are ordinary columns."
    },
    {
      "label": "BQ_KPIMeasure",
      "identity": "measure_id",
      "role": "Query definition with name, value_column, aggregation, and filters. Not a column."
    },
    {
      "label": "LookMLKPIMeasure",
      "identity": "measure_id",
      "role": "LookML measure with type, sql, label, description, value_format_name, and filters."
    },
    {
      "label": "Metric",
      "identity": "metric_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN METRIC."
    },
    {
      "label": "Source",
      "identity": "source_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN SOURCE."
    },
    {
      "label": "Market",
      "identity": "market_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN MARKET."
    },
    {
      "label": "Segment",
      "identity": "segment_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN SEGMENT."
    },
    {
      "label": "Channel",
      "identity": "channel_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN CHANNEL."
    },
    {
      "label": "Product",
      "identity": "product_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN PRODUCT_TYPE."
    },
    {
      "label": "MetricGroup",
      "identity": "group_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN GROUP_ALL."
    },
    {
      "label": "MetricLevel",
      "identity": "level_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN METRIC_TYPE."
    },
    {
      "label": "Unit",
      "identity": "unit_id",
      "role": "Vocabulary term. DESCRIBES_COLUMN UNIT_TYPE."
    },
    {
      "label": "Corridor",
      "identity": "corridor_id",
      "role": "No sample node until a corridor name exists. The CORRIDOR column is still loaded."
    }
  ],
  "relationships": [
    {
      "type": "HAS_COLUMN",
      "from": "BQ_Table",
      "to": "BQ_column",
      "rule": "One edge per physical column."
    },
    {
      "type": "ON_TABLE",
      "from": "BQ_KPIMeasure",
      "to": "BQ_Table",
      "rule": "The table the measure is queried from."
    },
    {
      "type": "USES_COLUMN",
      "from": "BQ_KPIMeasure",
      "to": "BQ_column",
      "rule": "Only the value column and the filter columns. Not the full catalog."
    },
    {
      "type": "ALIGNS_WITH",
      "from": "LookMLKPIMeasure",
      "to": "BQ_KPIMeasure",
      "rule": "Optional. Same business amount."
    },
    {
      "type": "READS_COLUMN",
      "from": "LookMLKPIMeasure",
      "to": "BQ_column",
      "rule": "Column parsed from ${TABLE}.<column>."
    },
    {
      "type": "DEFINED_ON",
      "from": "LookMLKPIMeasure",
      "to": "BQ_Table",
      "rule": "${TABLE} in the LookML sql."
    },
    {
      "type": "FILTERS_COLUMN",
      "from": "LookMLKPIMeasure",
      "to": "BQ_column",
      "rule": "Column a filter key resolves to. The value stays on the measure."
    },
    {
      "type": "DESCRIBES_COLUMN",
      "from": "vocabulary term",
      "to": "BQ_column",
      "rule": "Word match only. Not required to build the SQL."
    }
  ],
  "sample_measures": [
